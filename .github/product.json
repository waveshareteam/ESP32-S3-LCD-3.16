{
  "$schema": "https://raw.githubusercontent.com/waveshareteam/esp32-repo-template/v1/schema/product.schema.json",
  "product": "ESP32-S3-LCD-3.16",
  "product_url": "https://www.waveshare.com/esp32-s3-lcd-3.16.htm",
  "tier": 1,
  "target": "esp32s3",
  "esp_idf": {
    "versions": [
      "v5.5.6",
      "v6.1.1"
    ]
  },
  "arduino": {
    "core": "3.3.12",
    "fqbn": "esp32:esp32:esp32s3:FlashSize=16M,PartitionScheme=app3M_fat9M_16MB,PSRAM=opi,USBMode=hwcdc,CDCOnBoot=cdc"
  },
  "factory_firmware": {
    "esp_idf": "v5.3.2"
  },
  "overrides": {
    "markdown_audit": {
      "classification_rules": [
        {
          "category": "embedded_upstream",
          "patterns": [
            "examples/esp-idf/02_I2C_PCF85063/components/SensorLib/**",
            "examples/esp-idf/03_I2C_QMI8658/components/SensorLib/**",
            "examples/factory/components/SensorLib/**"
          ]
        }
      ]
    }
  }
}
